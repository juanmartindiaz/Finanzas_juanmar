# ============================================================
# .gitignore raíz — Flutter + Node.js
# (la app tiene además su propio app/.gitignore generado por Flutter)
# ============================================================

# ---------- Node.js (whatsapp_bot) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
package-lock.json.bak

# ---------- Variables de entorno y secretos ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# ---------- Dart / Flutter ----------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
*.g.dart.bak
.metadata.bak

# ---------- Android ----------
local.properties
*.apk
*.aab
*.ap_
*.dex
.cxx/
.gradle/
app/android/.gradle/
app/android/local.properties
app/android/key.properties
app/android/app/release/
app/android/app/debug/
app/android/app/profile/

# ---------- IDE / editores ----------
.idea/
*.iml
.vscode/
*.swp
*.swo
.history/

# ---------- Sistema operativo ----------
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
$RECYCLE.BIN/

# ---------- Temporales y registros ----------
*.log
*.tmp
*.bak
*.orig
tmp/
temp/

# ---------- Documentos temporales ----------
~$*

# ---------- Bot WhatsApp (Fase 2.3) ----------
whatsapp_bot/config.json
whatsapp_bot/auth/
whatsapp_bot/cola/pendientes/
whatsapp_bot/cola/entregados/
whatsapp_bot/logs/
whatsapp_bot/node_modules/
